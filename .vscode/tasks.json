{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-debug",
            "type": "shell",
            "command": "D:/development/msys64/usr/bin/bash.exe",
            "args": [
                "-lc",
                "cd /d/development/swars/debug && make -j$(nproc)"
            ],
            "options": {
                "cwd": "${workspaceFolder}/debug",
                "env": {
                    "MSYSTEM": "MINGW32",
                    "CHERE_INVOKING": "1"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["relative", "${workspaceFolder}/debug/src"]
            }
        },
        {
            "label": "build-release",
            "type": "shell",
            "command": "D:/development/msys64/usr/bin/bash.exe",
            "args": [
                "-lc",
                "cd /d/development/swars/release && make -j$(nproc)"
            ],
            "options": {
                "cwd": "${workspaceFolder}/release",
                "env": {
                    "MSYSTEM": "MINGW32",
                    "CHERE_INVOKING": "1"
                }
            },
            "group": "build",
            "problemMatcher": {
                "base": "$gcc",
                "fileLocation": ["relative", "${workspaceFolder}/release/src"]
            }
        },
        {
            // Starts mission 1 and records a video of its window, from the moment the window opens to the moment it
            // is closed; the video goes to the "videos" folder. Needs ffmpeg.
            "label": "record-mission-1",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/tools/record-mission.ps1",
                "-Mission", "0,1"
            ],
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": []
        },
        {
            // The same with the build done first
            "label": "build-and-record-mission-1",
            "dependsOn": ["build-debug", "record-mission-1"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
