{
    // Entries are grouped in the dropdown: "presentation.group" makes the dividers,
    // "order" sorts within a group.
    // "-b" opens the window without taking the focus, "-M" mutes the sound; the debug and\n    // build-and-launch entries use them, so that testing does not interrupt other work.\n    "version": "0.2.0",
    "configurations": [
        // ---------------------------------------------------------------- Debug
        {
            "name": "▶️  Debug: Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "D:/development/swars/debug/src/syndwarsfx.exe",
            "args": ["-g", "-W", "-b", "-M"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/debug/src",
            "environment": [
                {
                    "name": "PATH",
                    "value": "D:/development/msys64/mingw32/bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Abilita la riformattazione per gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "presentation": { "group": "1 Debug", "order": 1 }
        },
        {
            "name": "🔨▶️  Debug: Build & Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "D:/development/swars/debug/src/syndwarsfx.exe",
            "args": ["-g", "-W", "-b", "-M"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/debug/src",
            "environment": [
                {
                    "name": "PATH",
                    "value": "D:/development/msys64/mingw32/bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "preLaunchTask": "build-debug",
            "MIMode": "gdb",
            "miDebuggerPath": "D:/development/msys64/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Abilita la riformattazione per gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "presentation": { "group": "1 Debug", "order": 2 }
        },
        {
            "name": "🔨  Debug: Build only",
            "type": "node-terminal",
            "request": "launch",
            "command": "$env:MSYSTEM='MINGW32'; $env:CHERE_INVOKING='1'; & 'D:/development/msys64/usr/bin/bash.exe' -lc 'cd /d/development/swars/debug && make -j$(nproc)'",
            "cwd": "${workspaceFolder}/debug",
            "presentation": { "group": "1 Debug", "order": 3 }
        },

